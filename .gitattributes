# 换行符统一：仓库内一律 LF，避免 Windows / macOS / Linux 混用造成整文件 diff
* text=auto eol=lf

# Windows 脚本保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.jar   binary
*.zip   binary
*.xlsx  binary
